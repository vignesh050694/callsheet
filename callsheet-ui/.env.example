# Copy to .env.local. Only VITE_-prefixed vars reach the browser bundle —
# never put a secret in this file.

# Base path the app calls. Left as /api so the Vite dev proxy handles it.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api. Build-time only, not exposed to the client.
VITE_BACKEND_ORIGIN=http://localhost:8000
