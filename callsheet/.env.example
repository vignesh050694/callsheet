# Copy to .env and adjust. Never commit .env.

APP_NAME=callsheet
ENVIRONMENT=local

# debug | info | warning | error
LOG_LEVEL=debug
# json logs in prod, console-rendered logs locally
LOG_FORMAT=console

API_V1_PREFIX=/api/v1

# Async SQLAlchemy URL. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://callsheet:callsheet@localhost:5432/callsheet
DATABASE_ECHO=false

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Monid MCP / collection layer credentials (E03). Left blank until wired up.
MONID_API_KEY=
