# Copy to .env and adjust. Never commit .env.

APP_NAME=callsheet
ENVIRONMENT=local

# debug | info | warning | error
LOG_LEVEL=debug
# json logs in prod, console-rendered logs locally
LOG_FORMAT=console

API_V1_PREFIX=/api/v1

# Async SQLAlchemy URL. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://callsheet:callsheet@localhost:5432/callsheet
DATABASE_ECHO=false

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Monid credentials for the collection layer (E03). Blank is a supported state: the setup
# preview and the poller both refuse and say so, rather than returning empty results that
# would read as "nobody is talking about this film".
#
# Setting it turns on real, billed provider calls in two places at once — the setup
# preview (one PER_CALL search per press, ~$0.0015) and the collection worker.
MONID_API_KEY=
MONID_BASE_URL=https://api.monid.ai

# A run is queued and then polled until it finishes. Monid bills at the start, so the
# timeout is a ceiling on waiting, not a retry budget — nothing re-runs a call that has
# already been paid for. Runs typically take 1-120 seconds.
MONID_RUN_TIMEOUT_SECONDS=120
MONID_POLL_INTERVAL_SECONDS=2
MONID_REQUEST_TIMEOUT_SECONDS=30
